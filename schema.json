{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/daily-tasks/schema.json",
  "title": "Daily Tasks Data",
  "description": "Schema for the Daily Tasks data file shared between CLI and mobile apps",
  "type": "object",
  "required": ["last_reset", "next_id", "tasks", "theme_index"],
  "properties": {
    "last_reset": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date when tasks were last reset (YYYY-MM-DD format). When this date differs from today, tasks visible today are moved to 'todo' status."
    },
    "next_id": {
      "type": "integer",
      "minimum": 1,
      "description": "Next available task ID. Incremented each time a new task is created."
    },
    "tasks": {
      "type": "array",
      "description": "List of all tasks",
      "items": {
        "$ref": "#/definitions/task"
      }
    },
    "theme_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 24,
      "description": "Index of the selected theme (0-24)"
    },
    "last_modified": {
      "type": "integer",
      "description": "Unix timestamp (milliseconds) of last modification. Used for conflict detection during sync."
    }
  },
  "definitions": {
    "task": {
      "type": "object",
      "required": ["id", "title", "duration", "status", "order"],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "description": "Unique task identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Task title"
        },
        "duration": {
          "type": "integer",
          "minimum": 1,
          "description": "Estimated duration in minutes"
        },
        "status": {
          "type": "string",
          "enum": ["todo", "done", "skipped"],
          "description": "Task completion status"
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "description": "Display order within the status column. Lower numbers appear first."
        },
        "deadline": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}$",
          "description": "Optional daily deadline time in HH:MM format. A notification is sent at this time each day when the task is still in 'todo' status."
        },
        "visibility": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          },
          "uniqueItems": true,
          "description": "Days of the week when this task is visible (0=Sunday, 1=Monday, ..., 6=Saturday). If omitted or empty, the task is visible every day."
        }
      }
    }
  },
  "examples": [
    {
      "last_reset": "2026-01-23",
      "next_id": 5,
      "tasks": [
        {
          "id": 1,
          "title": "Morning routine",
          "duration": 15,
          "status": "todo",
          "order": 1
        },
        {
          "id": 2,
          "title": "Exercise",
          "duration": 30,
          "status": "done",
          "order": 1
        }
      ],
      "theme_index": 0,
      "last_modified": 1737628800000
    }
  ]
}
