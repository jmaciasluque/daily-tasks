{
  "cli": {
    "version": ">= 5.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production"
    },
    "testing": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "channel": "testing",
      "env": {
        "APP_VARIANT": "testing"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
